  m_text: "\u0414\u043E\u0441\u0442\u0430\u0432\u044C\u0442\u0435 \u0433\u0440\u0443\u0437
    \u0432 \u041B\u0435\u043D\u0438\u043D\u0433\u0440\u0430\u0434, \u0430 \u0437\u0430\u0442\u0435\u043C
